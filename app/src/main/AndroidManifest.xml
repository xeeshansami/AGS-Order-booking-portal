<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Photo/video media permissions are NOT used (Play policy). Explicitly
         strip them from the merged manifest in case a dependency injects them. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ (API 30) package visibility. Required so the app can detect
         and launch a maps app (geo: intents) and open web links. Without this,
         resolveActivity() returns null and the app wrongly reports
         "Google Maps not installed". -->
    <queries>
        <package android:name="com.google.android.apps.maps" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

        <application
        android:name="com.agsadil.agssalesandroidclientorderdocter.Network.MyApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:replace="android:allowBackup"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">
        <activity
            android:exported="true"
            android:name="com.agsadil.agssalesandroidclientorderdocter.Activities.NotificationActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity"></activity>
       <activity
            android:exported="true"
            android:name="com.agsadil.agssalesandroidclientorderdocter.Activities.SettingsActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity"></activity>
        <activity
            android:exported="true"
            android:name="com.agsadil.agssalesandroidclientorderdocter.Activities.NotificationDetails"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity"></activity>
        <activity
            android:exported="true"
            android:name="com.agsadil.agssalesandroidclientorderdocter.Activities.PdfWebViewActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />
        <activity
            android:exported="true"
            android:name="com.agsadil.agssalesandroidclientorderdocter.Activities.FeedbackFormActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />
        <activity
            android:exported="true"
            android:name="com.agsadil.agssalesandroidclientorderdocter.Activities.ProductOfferActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />
        <activity
            android:exported="true"
            android:name="com.agsadil.agssalesandroidclientorderdocter.Activities.ForgetActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />
        <activity
            android:exported="true"
            android:name="com.agsadil.agssalesandroidclientorderdocter.Activities.VarificationActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />
        <activity
            android:exported="true"
            android:name="com.agsadil.agssalesandroidclientorderdocter.Activities.ChangePassword"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />
        <activity
            android:exported="true"
            android:name="com.agsadil.agssalesandroidclientorderdocter.Activities.EditSingleProduct"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />
        <activity
            android:exported="true"
            android:name="com.agsadil.agssalesandroidclientorderdocter.Activities.UpdateProfile"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />
        <activity
            android:exported="true"
            android:name="com.agsadil.agssalesandroidclientorderdocter.Activities.UpdateCustomerProfile"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />
        <activity
            android:exported="true"
            android:name="com.agsadil.agssalesandroidclientorderdocter.Activities.MapPickerActivity"
            android:parentActivityName="com.agsadil.agssalesandroidclientorderdocter.Activities.UpdateCustomerProfile"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />

        <activity
            android:exported="true"
            android:name="com.agsadil.agssalesandroidclientorderdocter.Activities.SplashScreen"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:exported="true"
            android:name="com.agsadil.agssalesandroidclientorderdocter.Activities.OrderFormActivity"
            android:launchMode="singleTop"
            android:parentActivityName="com.agsadil.agssalesandroidclientorderdocter.Activities.DashboardActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateAlwaysHidden"
            tools:ignore="LockedOrientationActivity" />
        <activity
            android:exported="true"
            android:name="com.agsadil.agssalesandroidclientorderdocter.Activities.CustomerActivity"
            android:parentActivityName="com.agsadil.agssalesandroidclientorderdocter.Activities.OrderFormActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />
        <activity
            android:exported="true"
            android:name="com.agsadil.agssalesandroidclientorderdocter.Activities.ProductActivity"
            android:parentActivityName="com.agsadil.agssalesandroidclientorderdocter.Activities.OrderFormActivity" />
        <activity
            android:exported="true"
            android:name="com.agsadil.agssalesandroidclientorderdocter.Activities.LoginActivity"
            android:parentActivityName="com.agsadil.agssalesandroidclientorderdocter.Activities.OrderFormActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />
        <activity
            android:exported="true"
            android:name="com.agsadil.agssalesandroidclientorderdocter.Activities.DashboardActivity"
            android:label="@string/title_activity_dashboard"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme"
            tools:ignore="LockedOrientationActivity" />
        <activity
            android:exported="true"
            android:name="com.agsadil.agssalesandroidclientorderdocter.Activities.OrderListActivity"
            android:parentActivityName="com.agsadil.agssalesandroidclientorderdocter.Activities.DashboardActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />
        <activity
            android:exported="true"
            android:name="com.agsadil.agssalesandroidclientorderdocter.Activities.ActivityOrderProductsDetail"
            android:parentActivityName="com.agsadil.agssalesandroidclientorderdocter.Activities.OrderListActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />
        <activity
            android:exported="true"
            android:name="com.agsadil.agssalesandroidclientorderdocter.Activities.SignupActivity"
            android:label="@string/title_activity_signup_acitivity" />


        <service
            android:name="com.agsadil.agssalesandroidclientorderdocter.Fcm.MyFirebaseMessagingService"
            android:permission="com.google.android.c2dm.permission.SEND"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
                <action android:name="com.google.android.c2dm.intent.RECEIVE" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/icon" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/colorPrimary" />
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_key" />
        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>
    </application>

</manifest>