<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="fill_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:theme="@style/AppTheme.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:titleTextColor="@color/toolBarTextColor"
            app:subtitleTextColor="@color/toolBarTextColor"
            android:background="@color/toolBarBackground"
            app:popupTheme="@style/AppTheme.PopupOverlay"></androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="fill_parent"
        android:layout_below="@+id/app_bar"
        android:layout_centerInParent="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/unit_5"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="sans-serif-smallcaps"
                    android:text="@string/app_name"
                    android:textColor="@color/colorPrimary"
                    android:textSize="20dp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="sans-serif-smallcaps"
                    android:textColor="@color/grey"
                    android:text="Update customer profile here" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="@dimen/unit_10">

                <!-- Select Customer -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/border_edge_edittext"
                        android:orientation="vertical">
                        <Button
                            android:id="@+id/btnSelectCustomer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:background="@color/colorPrimary"
                            android:fontFamily="sans-serif-smallcaps"
                            android:gravity="left|center_vertical"
                            android:onClick="SelectCustomer"
                            android:paddingLeft="@dimen/unit_10"
                            android:text="Select Customer"
                            android:textColor="@color/white" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="Select Customer"
                        android:textColor="@color/colorPrimary"
                        android:textSize="12dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginLeft="10dp" />
                </RelativeLayout>

                <!-- Customer Name -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/border_edge_edittext"
                        android:orientation="vertical">
                        <EditText
                            android:id="@+id/customer_name"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_margin="5dp"
                            android:background="@null"
                            android:hint="Customer Name"
                            android:inputType="text"
                            android:singleLine="true"
                            android:textColor="@color/ink_blue"
                            android:textSize="15dp"
                            android:drawableLeft="@drawable/ic_username"
                            android:drawableTint="@color/colorPrimary" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="Customer Name"
                        android:textColor="@color/colorPrimary"
                        android:textSize="12dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginLeft="10dp" />
                </RelativeLayout>

                <!-- Email -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/border_edge_edittext"
                        android:orientation="vertical">
                        <EditText
                            android:id="@+id/customer_email"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_margin="5dp"
                            android:background="@null"
                            android:hint="Email Address"
                            android:inputType="textEmailAddress"
                            android:singleLine="true"
                            android:textColor="@color/ink_blue"
                            android:textSize="15dp"
                            android:drawableLeft="@drawable/ic_email"
                            android:drawableTint="@color/colorPrimary" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="Email Address"
                        android:textColor="@color/colorPrimary"
                        android:textSize="12dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginLeft="10dp" />
                </RelativeLayout>

                <!-- Contact/Mobile -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/border_edge_edittext"
                        android:orientation="vertical">
                        <EditText
                            android:id="@+id/customer_contact"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_margin="5dp"
                            android:background="@null"
                            android:hint="Contact"
                            android:inputType="number"
                            android:singleLine="true"
                            android:textColor="@color/ink_blue"
                            android:textSize="15dp"
                            android:drawableLeft="@drawable/ic_contact"
                            android:drawableTint="@color/colorPrimary" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="Contact"
                        android:textColor="@color/colorPrimary"
                        android:textSize="12dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginLeft="10dp" />
                </RelativeLayout>

                <!-- CNIC -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/border_edge_edittext"
                        android:orientation="vertical">
                        <EditText
                            android:id="@+id/customer_cnic"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_margin="5dp"
                            android:background="@null"
                            android:hint="CNIC"
                            android:inputType="number"
                            android:singleLine="true"
                            android:textColor="@color/ink_blue"
                            android:textSize="15dp"
                            android:drawableLeft="@drawable/ic_username"
                            android:drawableTint="@color/colorPrimary" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="CNIC"
                        android:textColor="@color/colorPrimary"
                        android:textSize="12dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginLeft="10dp" />
                </RelativeLayout>

                <!-- Prop (Proprietor) -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/border_edge_edittext"
                        android:orientation="vertical">
                        <EditText
                            android:id="@+id/customer_prop"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_margin="5dp"
                            android:background="@null"
                            android:hint="Proprietor"
                            android:inputType="text"
                            android:singleLine="true"
                            android:textColor="@color/ink_blue"
                            android:textSize="15dp"
                            android:drawableLeft="@drawable/ic_username"
                            android:drawableTint="@color/colorPrimary" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="Proprietor"
                        android:textColor="@color/colorPrimary"
                        android:textSize="12dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginLeft="10dp" />
                </RelativeLayout>

                <!-- Address -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/border_edge_edittext"
                        android:orientation="vertical">
                        <EditText
                            android:id="@+id/customer_address"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_margin="5dp"
                            android:background="@null"
                            android:hint="Address"
                            android:inputType="text"
                            android:singleLine="true"
                            android:textColor="@color/ink_blue"
                            android:textSize="15dp"
                            android:drawableLeft="@drawable/ic_username"
                            android:drawableTint="@color/colorPrimary" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="Address"
                        android:textColor="@color/colorPrimary"
                        android:textSize="12dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginLeft="10dp" />
                </RelativeLayout>

                <!-- Licence No -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/border_edge_edittext"
                        android:orientation="vertical">
                        <EditText
                            android:id="@+id/customer_licences"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_margin="5dp"
                            android:background="@null"
                            android:hint="Licence No"
                            android:inputType="text"
                            android:singleLine="true"
                            android:textColor="@color/ink_blue"
                            android:textSize="15dp"
                            android:drawableLeft="@drawable/ic_username"
                            android:drawableTint="@color/colorPrimary" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="Licence No"
                        android:textColor="@color/colorPrimary"
                        android:textSize="12dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginLeft="10dp" />
                </RelativeLayout>

                <!-- Contact No -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/border_edge_edittext"
                        android:orientation="vertical">
                        <EditText
                            android:id="@+id/customer_contact_person"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_margin="5dp"
                            android:background="@null"
                            android:hint="Contact No"
                            android:inputType="number"
                            android:singleLine="true"
                            android:textColor="@color/ink_blue"
                            android:textSize="15dp"
                            android:drawableLeft="@drawable/ic_contact"
                            android:drawableTint="@color/colorPrimary" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="Contact No"
                        android:textColor="@color/colorPrimary"
                        android:textSize="12dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginLeft="10dp" />
                </RelativeLayout>

                <!-- Licence Date -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/border_edge_edittext"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/customer_date"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_margin="5dp"
                            android:background="@null"
                            android:clickable="true"
                            android:drawableLeft="@mipmap/ic_date"
                            android:drawableTint="@color/colorPrimary"
                            android:gravity="center_vertical"
                            android:text="Select Date"
                            android:textColor="@color/ink_blue"
                            android:textSize="15dp"
                            android:paddingLeft="5dp" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="Licence Date"
                        android:textColor="@color/colorPrimary"
                        android:textSize="12dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginLeft="10dp" />
                </RelativeLayout>

                <!-- STRN Number -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/border_edge_edittext"
                        android:orientation="vertical">
                        <EditText
                            android:id="@+id/customer_strn"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_margin="5dp"
                            android:background="@null"
                            android:hint="STRN Number"
                            android:inputType="text"
                            android:singleLine="true"
                            android:textColor="@color/ink_blue"
                            android:textSize="15dp"
                            android:drawableLeft="@drawable/ic_username"
                            android:drawableTint="@color/colorPrimary" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="STRN Number"
                        android:textColor="@color/colorPrimary"
                        android:textSize="12dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginLeft="10dp" />
                </RelativeLayout>

                <!-- Location (vLat, vLong) -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/border_edge_edittext"
                        android:orientation="vertical">
                        <EditText
                            android:id="@+id/customer_location"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_margin="5dp"
                            android:background="@null"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:hint="Latitude"
                            android:inputType="numberSigned|numberDecimal"
                            android:singleLine="true"
                            android:textColor="@color/ink_blue"
                            android:textSize="15dp" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="Latitude"
                        android:textColor="@color/colorPrimary"
                        android:textSize="12dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginLeft="10dp" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/border_edge_edittext"
                        android:orientation="vertical">
                        <EditText
                            android:id="@+id/customer_vLong"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_margin="5dp"
                            android:background="@null"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:hint="Longitude"
                            android:inputType="numberSigned|numberDecimal"
                            android:singleLine="true"
                            android:textColor="@color/ink_blue"
                            android:textSize="15dp" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="Longitude"
                        android:textColor="@color/colorPrimary"
                        android:textSize="12dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginLeft="10dp" />
                </RelativeLayout>

                <!--Pick Location on Map-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnPickLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/colorPrimary"
                        android:drawableLeft="@drawable/ic_location_on"
                        android:drawableTint="@color/white"
                        android:fontFamily="sans-serif-smallcaps"
                        android:gravity="center"
                        android:text="Pick Location on Map"
                        android:textColor="@color/white" />
                </LinearLayout>

                <!--Update Button-->
                <LinearLayout
                    android:paddingTop="@dimen/unit_10"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20px"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/update_btn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="60dp"
                        android:layout_marginRight="60dp"
                        android:background="@drawable/bg_changes"
                        android:fontFamily="sans-serif-smallcaps"
                        android:singleLine="false"
                        android:text="Update"
                        android:textColor="@color/white" />

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
