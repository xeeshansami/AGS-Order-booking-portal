<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Deny cleartext (HTTP) traffic by default. The API is served over HTTPS. -->
    <base-config cleartextTrafficPermitted="false" />
    <!-- Domain must be a host only (no scheme/path). HTTPS is enforced here too. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">mobile.agssukkur.com</domain>
    </domain-config>
</network-security-config>
