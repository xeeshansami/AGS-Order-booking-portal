<?xml version="1.0" encoding="utf-8"?>
<!--
   Controls Android 12+ (API 31+) backup behaviour. Cloud backup and
   device-to-device transfer of app data are disabled so customer data is not
   copied off the device through the backup framework.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
